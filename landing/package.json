{
  "name": "dhruv-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "^14.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
